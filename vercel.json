{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/services",
      "destination": "/api/index.py"
    },
    {
      "source": "/tokens",
      "destination": "/api/index.py"
    },
    {
      "source": "/tokens/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/queue",
      "destination": "/api/index.py"
    },
    {
      "source": "/counters",
      "destination": "/api/index.py"
    },
    {
      "source": "/seed-demo",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!health|services|tokens|queue|counters|seed-demo|docs|openapi.json|api).*)",
      "destination": "/index.html"
    }
  ]
}
